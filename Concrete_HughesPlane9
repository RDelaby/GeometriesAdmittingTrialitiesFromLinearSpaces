N := DicksonNearfield(3,2);
HP := HughesPlane(N);
Elts := [* *];

for x in [1 .. 3] do

        for L in Lines(HP) do

                for P in Points(HP) do

                        if (P in L) then

                                J := [* x, L, P *];

                                Append(~Elts,J);

                        end if;

                end for;

        end for;

end for;

#Elts;

e := [];

n := Truncate(#Elts/3);

for i in [1 .. n] do

        for j in [n+1 .. 2*n] do

                if not(Elts[i][2] eq Elts[j][2]) and (Elts[i][3] in Elts[j][2]) and not(Elts[j][3] in Elts[i][2]) then

                        Append(~e,{i,j});

                end if;

        end for;

end for;

for i in [2*n+1 .. 3*n] do

        for j in [1 .. n] do

                if not(Elts[i][2] eq Elts[j][2]) and (Elts[i][3] in Elts[j][2]) and not(Elts[j][3] in Elts[i][2]) then

                        Append(~e,{i,j});

                end if;

        end for;
end for;

for i in [n+1 .. 2*n] do

        for j in [2*n+1 .. 3*n] do

                if not(Elts[i][2] eq Elts[j][2]) and (Elts[i][3] in Elts[j][2]) and not(Elts[j][3] in Elts[i][2]) then

                        Append(~e,{i,j});

                end if;

        end for;

end for;

gr := Graph<#Elts|Set(e)>;

v := VertexSet(gr);

labels := [];

for i in [1 .. n] do

        Append(~labels,1);

end for;

for j in [1 .. n] do

        Append(~labels,2);

end for;

for k in [1 .. n] do

        Append(~labels,3);

end for;

AssignLabels(v,labels);

ig := IncidenceGeometry(gr);

IsThin(ig);

IsRC(ig);

IsFTGeometry(ig);

CorrelationGroup(ig);

AutomorphismGroup(ig);
ok,cg:=CosetGeometry(ig);
d,v,e:=Diagram(cg);
for x in v do print x,Label(x);end for;
for x in e do print x,Label(x);end for;

