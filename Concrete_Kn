/* n >= 4 realised as a coset geometry */

n := 10;

G := Sym(n);

G_1 := Stabilizer(G,{1}) meet Stabilizer(G,{1,3});
G_2 := Stabilizer(G,{2}) meet Stabilizer(G,{1,2});
G_3 := Stabilizer(G,{3}) meet Stabilizer(G,{2,3});

cg := CosetGeometry(G,{G_1,G_2,G_3});

ig := IncidenceGeometry(cg);

IsThin(ig);

IsRC(ig);

IsFTGeometry(ig);

AG := AutomorphismGroup(ig);

CG := CorrelationGroup(ig);

AutomorphismGroup(ig);
ok,cg:=CosetGeometry(ig);
d,v,e:=Diagram(cg);
for x in v do print x,Label(x);end for;
for x in e do print x,Label(x);end for;
