G := PGammaU(3,4);

p_1 := {@ 1 @};
L_1 := {@ 1,2,5,13,28 @};

p_2 := {@ 3 @};
L_2 := {@ 1,3,11,20,51 @};

p_3 := {@ 5 @};
L_3 := {@ 3,5,7,48,31 @};

G_1 := Stabilizer(G,p_1) meet Stabilizer(G,L_1);
G_2 := Stabilizer(G,p_2) meet Stabilizer(G,L_2);
G_3 := Stabilizer(G,p_3) meet Stabilizer(G,L_3);

cg := CosetGeometry(G,{G_1,G_2,G_3});

ig := IncidenceGeometry(cg);

IsThin(ig);

IsRC(ig);

IsFTGeometry(ig);

CorrelationGroup(ig);

AutomorphismGroup(ig);
ok,cg:=CosetGeometry(ig);
d,v,e:=Diagram(cg);
for x in v do print x,Label(x);end for;
for x in e do print x,Label(x);end for;
