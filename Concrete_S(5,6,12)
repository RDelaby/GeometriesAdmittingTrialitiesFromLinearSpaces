/* warning : since this is not a linear space, different definitions of the triangle complex are not equivalent. I use a particular one which leads to a geometry that is not FT, RC, AG = M12, CG = M12 x C3 */
load m12;

base := {1,2,3,4,5,10};
blocks := Orbit(G,base);

Elts := [* *];

for x in [1 .. 3] do

        for L in blocks do

                for P in [1..24] do

                        if (P in L) then

                                J := [* x, L, P *];

                                Append(~Elts,J);

                        end if;

                end for;

        end for;

end for;

#Elts;

e := [];

n := Truncate(#Elts/3);

for i in [1 .. n] do

        for j in [n+1 .. 2*n] do

                if (Elts[i][3] in Elts[j][2]) and not(Elts[j][3] in Elts[i][2]) then

                        Append(~e,{i,j});

                end if;

        end for;

end for;

for i in [2*n+1 .. 3*n] do

        for j in [1 .. n] do

                if (Elts[i][3] in Elts[j][2]) and not(Elts[j][3] in Elts[i][2]) then

                        Append(~e,{i,j});

                end if;

        end for;
end for;

for i in [n+1 .. 2*n] do

        for j in [2*n+1 .. 3*n] do

                if (Elts[i][3] in Elts[j][2]) and not(Elts[j][3] in Elts[i][2]) then

                        Append(~e,{i,j});

                end if;

        end for;

end for;

gr := Graph<#Elts|Set(e)>;

v := VertexSet(gr);

labels := [];

for i in [1 .. n] do

        Append(~labels,1);

end for;

for j in [1 .. n] do

        Append(~labels,2);

end for;

for k in [1 .. n] do

        Append(~labels,3);

end for;

AssignLabels(v,labels);

ig := IncidenceGeometry(gr);
